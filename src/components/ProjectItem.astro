---
interface Props {
	icon: string;
	name: string;
	url: string;
	text: string;
}

const { icon, name, url, text } = Astro.props;
---

<li>
	<a href={url} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">{icon}</span> <b>{name}</b></a>:{" "}<span class="dimmed">{text}</span>
</li>

<style>
	.dimmed {
		color: #828282;
	}
</style>
