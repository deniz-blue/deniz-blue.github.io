---
import { emptyContributionYears, fetchContributionYears } from "~/scripts/github";

const loadedYears = await fetchContributionYears();
const years = loadedYears ?? emptyContributionYears();
const firstWeekday = (date: string) => new Date(date).getUTCDay();
---

{
	years.length > 0 && (
		<div class="activity">
			<div class="graph-frame" data-drag-scroll data-solid>
				<div class="years">
					{years.map(({ year, days }) => (
						<div class="year">
							<div class="graph" style={{ "--first-row": firstWeekday(days[0]!.date) + 1 }}>
								{days.map(({ date, level }) => (
									<span class={`level-${level}`} title={date} />
								))}
							</div>
							<span class="year-label">{year}</span>
						</div>
					))}
				</div>
			</div>
			{loadedYears === undefined && <p class="load-failed">Failed to load</p>}
		</div>
	)
}

<script>
	import { scrollByDragging } from "~/scripts/dragToScroll";

	document.querySelectorAll<HTMLElement>("[data-drag-scroll]").forEach(scrollByDragging);
</script>

<style>
	.activity {
		position: relative;
	}

	.load-failed {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border-radius: var(--radius-sm);
		background: rgb(11 11 13 / 55%);
		color: var(--color-text-dim);
		font-weight: 600;
	}

	.graph-frame {
		/* A right-to-left scroll container opens scrolled to its right end. */
		direction: rtl;
		overflow-x: auto;
		padding-bottom: 0.375rem;
		scrollbar-width: thin;
		scrollbar-color: rgb(255 255 255 / 15%) transparent;
		cursor: grab;
		user-select: none;
	}

	.graph-frame:active {
		cursor: grabbing;
	}

	.years {
		direction: ltr;
		display: flex;
		gap: var(--spacing-sm);
		width: max-content;
	}

	.year {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.year-label {
		color: var(--color-text-dim);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.graph {
		display: grid;
		grid-template-rows: repeat(7, 10px);
		grid-auto-flow: column;
		grid-auto-columns: 10px;
		gap: 3px;
	}

	.graph span:first-child {
		grid-row-start: var(--first-row);
	}

	.graph span {
		border-radius: 2px;
		background: rgb(255 255 255 / 6%);
	}

	.graph .level-1 {
		background: rgb(164 107 255 / 30%);
	}

	.graph .level-2 {
		background: rgb(164 107 255 / 55%);
	}

	.graph .level-3 {
		background: rgb(164 107 255 / 80%);
	}

	.graph .level-4 {
		background: var(--color-primary);
	}
</style>
