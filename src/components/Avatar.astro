---
import heartParticle from "~/assets/avatar/heart-particle.png";
import avatarData from "~/assets/avatar/avatar.json";
import { PIXELS_PER_UNIT } from "~/scripts/avatar/css";
import type { AvatarData } from "~/scripts/avatar/types";
import AvatarTree from "~/components/AvatarTree.astro";

const avatar = avatarData as AvatarData;
const textureCss = Object.entries(avatar.shadedTextureUrls).map(([name, url]) => `.${name}{background-image:url("${url}")}`);
---

<div class="avatar" data-avatar aria-hidden="true">
	<div class="hearts" data-hearts="behind"></div>
	<div class="behind-card">
		<div class="layer" data-layer="body"><AvatarTree nodes={avatar.layers.body} /></div>
		<div class="layer" data-layer="arms"><AvatarTree nodes={avatar.layers.arms} /></div>
	</div>
	<div class="layer" data-layer="head"><AvatarTree nodes={avatar.layers.head} /></div>
	<div class="hearts" data-hearts="front"></div>
</div>

<style is:inline set:html={textureCss.join("")}></style>

<script>
	import { animateAvatar } from "~/scripts/avatar/animate";

	const avatar = document.querySelector<HTMLElement>("[data-avatar]");
	if (avatar) animateAvatar(avatar);
</script>

<style
	define:vars={{
		unit: `${PIXELS_PER_UNIT}px`,
		"texture-columns": avatar.textureSize.width,
		"texture-rows": avatar.textureSize.height,
		"heart-particle": `url("${heartParticle.src}")`,
	}}
>
	.avatar {
		--center-x: 78%;
		--edge-height: 22;
		--pose-RightArm: translate3d(calc(-2.5 * var(--unit)), 0, calc(4 * var(--unit))) rotateZ(172deg) rotateX(15deg);
		--pose-LeftArm: translate3d(calc(2.5 * var(--unit)), 0, calc(4 * var(--unit))) rotateZ(-172deg) rotateX(15deg);

		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--container-size-sm);
		height: calc(17 * var(--unit));
		pointer-events: none;
	}

	.avatar,
	.behind-card {
		perspective: calc(100 * var(--unit));
		perspective-origin: var(--center-x) calc(100% - 8 * var(--unit));
	}

	.behind-card {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.layer {
		position: absolute;
		top: calc(100% + var(--edge-height) * var(--unit));
		left: var(--center-x);
		transform-style: preserve-3d;
	}

	.layer[data-layer="arms"] {
		--edge-height: 28.5;
	}

	.layer[data-layer="head"] :global(.face) {
		pointer-events: auto;
	}

	.hearts {
		position: absolute;
		inset: 0;
	}

	.hearts :global(.heart) {
		position: absolute;
		top: 0;
		left: 0;
		background: var(--heart-particle) center / 100% no-repeat;
		image-rendering: pixelated;
	}
</style>
