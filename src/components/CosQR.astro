---
import { Image } from "astro:assets";
import Anchor from "~/components/Anchor.astro";
import cosIcon from "~/assets/icons/cos.png";
---

<div class="cos">
	<a
		class="badge"
		href="https://cos.tsx.lt"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="CosQR"
	>
		<span class="badge-head">Hello</span>
		<Image
			class="badge-logo"
			src={cosIcon}
			alt=""
			aria-hidden
			loading="eager"
			width={40}
			height={40}
			densities={[1, 2]}
		/>
	</a>
	<div class="column">
		<span> Do you make a lot of friends at conventions? </span>
		<span>
			Try <span class="name">CosQR</span> on <Anchor
				href="https://cos.tsx.lt">web</Anchor
			>{" "}or{" "}<Anchor
				href="https://play.google.com/store/apps/details?id=lt.tsx.cos"
				>Google Play</Anchor
			>
		</span>
	</div>
</div>

<style>
	.cos {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.badge {
		position: relative;
		display: flex;
		flex-shrink: 0;
		flex-direction: column;
		align-items: center;
		width: 40px;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: #1b1820;
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 10%),
			0 4px 10px rgb(0 0 0 / 45%);
		text-decoration: none;
		transform: scale(0.8) rotate(7deg);
		transition: transform 0.2s ease-in-out;
	}

	.badge-logo {
		display: block;
	}

	.badge::before {
		content: "";
		position: absolute;
		top: 2px;
		left: 50%;
		width: 10px;
		height: 3px;
		border-radius: var(--radius-xs);
		background: rgb(0 0 0 / 35%);
		transform: translateX(-50%);
	}

	.cos:hover .badge {
		transform: scale(1) rotate(4deg);
	}

	.badge-head {
		display: flex;
		justify-content: center;
		width: 100%;
		padding: 7px 0 2px;
		background: linear-gradient(135deg, #0192ff, #c901ff);
		color: var(--color-text-strong);
		font-size: 9px;
		font-weight: 700;
		line-height: 1.2;
		white-space: nowrap;
	}

	.name {
		color: var(--color-text-strong);
		font-weight: 500;
	}

	.column {
		display: flex;
		flex-direction: column;
	}
</style>
