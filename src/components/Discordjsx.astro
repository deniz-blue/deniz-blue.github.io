---
import { Code } from "astro:components";
import { Image } from "astro:assets";
import ArrowRight from "~/assets/icons/arrow-right.svg";
import discordjsxAvatar from "~/assets/icons/discordjsx-avatar.svg";
import Anchor from "~/components/Anchor.astro";

const example = `const [count, setCount] = useState(0);
<button onClick={increment}>
	Clicked {count} times
</button>`;
---

<div class="discordjsx">
	<p>
		I've made <Anchor href="https://github.com/deniz-blue/discordjsx"
			>a library</Anchor
		> that allows you to use React for Discord.js!
	</p>
	<div class="example">
		<div class="code" data-solid>
			<Code code={example} lang="tsx" theme="github-dark-dimmed" />
		</div>
		<ArrowRight class="arrow" aria-hidden="true" />
		<div class="discord-message">
			<Image
				class="avatar"
				src={discordjsxAvatar}
				alt=""
				width={40}
				height={40}
				data-solid
			/>
			<div class="message-body">
				<div class="author">
					<span class="name">discord-jsx-renderer</span>
					<span class="app">APP</span>
					<span class="time">17:01</span>
				</div>
				<button
					class="discord-button"
					type="button"
					data-clicker
					data-solid
				>
					<span class="label"
						>Clicked <span data-count>0</span> times</span
					>
					<span class="loading" aria-hidden="true"
						><span></span><span></span><span></span></span
					>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-clicker]");
	const count = button?.querySelector<HTMLElement>("[data-count]");
	if (button && count) {
		button.addEventListener("click", () => {
			if (button.ariaBusy === "true") return;
			button.ariaBusy = "true";
			setTimeout(() => {
				count.textContent = String(Number(count.textContent) + 1);
				button.ariaBusy = "false";
			}, 500);
		});
	}
</script>

<style>
	.discordjsx {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		container-type: inline-size;
	}

	.example {
		display: flex;
		gap: var(--spacing-sm);
	}

	.code {
		display: flex;
		flex: none;
		max-width: 100%;
		overflow: hidden;
		border-radius: var(--radius-md);
	}

	.code :global(pre) {
		display: flex;
		flex: 1;
		align-items: center;
		margin: 0;
		padding: var(--spacing-sm);
		font-size: var(--font-size-xs);
		tab-size: 2;
	}

	.arrow {
		flex: none;
		align-self: center;
		width: 1.25rem;
		height: 1.25rem;
		color: var(--color-text-dim);
	}

	.discord-message {
		display: flex;
		flex: 1;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-sm) var(--spacing-md);
		border-radius: var(--radius-md);
		background: #313338;
	}

	.avatar {
		flex: none;
		width: 2.5rem;
		height: 2.5rem;
	}

	.message-body {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 0.375rem;
	}

	.author {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		line-height: 1.3;
	}

	.name {
		color: #f2f3f5;
		font-weight: 600;
	}

	.app {
		padding: 0 0.25rem;
		border-radius: var(--radius-sm);
		background: #5865f2;
		color: #fff;
		font-size: var(--font-size-xs);
		font-weight: 700;
		line-height: 1rem;
	}

	.time {
		color: #949ba4;
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.discord-button {
		display: inline-grid;
		place-items: center;
		min-height: 2rem;
		padding: 0 var(--spacing-md);
		border: 0;
		border-radius: var(--radius-md);
		background: #5865f2;
		color: #fff;
		font: inherit;
		font-size: var(--font-size-sm);
		font-variant-numeric: tabular-nums;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.15s ease-in-out;
	}

	.discord-button:hover:not([aria-busy="true"]) {
		background: #4752c4;
	}

	.label,
	.loading {
		grid-area: 1 / 1;
	}

	.loading {
		display: flex;
		gap: 0.125rem;
		visibility: hidden;
	}

	.loading span {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: currentColor;
		animation: 1.4s ease-in-out infinite;
	}

	.loading span:nth-child(2) {
		animation-delay: 0.2s;
	}

	.loading span:nth-child(3) {
		animation-delay: 0.4s;
	}

	.discord-button[aria-busy="true"] {
		opacity: 0.5;
		cursor: default;
	}

	.discord-button[aria-busy="true"] .label {
		visibility: hidden;
	}

	.discord-button[aria-busy="true"] .loading {
		visibility: visible;
	}

	.discord-button[aria-busy="true"] .loading span {
		animation-name: discord-pulsing-ellipsis;
	}

	@keyframes discord-pulsing-ellipsis {
		0%,
		100% {
			opacity: 1;
			scale: 1;
		}

		50% {
			opacity: 0.3;
			scale: 0.8;
		}
	}

	@container (width < 40rem) {
		.example {
			flex-direction: column;
			align-items: stretch;
		}

		.arrow {
			align-self: center;
			rotate: 90deg;
		}
	}
</style>
