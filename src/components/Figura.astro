---
import { Image } from "astro:assets";
import figuraIcon from "~/assets/icons/figura.gif";
import Anchor from "~/components/Anchor.astro";
---

<p class="figura">
	<Image src={figuraIcon} alt="" aria-hidden loading="eager" width={24} height={24} densities={[1, 2]} />
	<span>That's my <Anchor href="https://figuramc.org/">Figura</Anchor> avatar on top of the page!</span>
</p>

<style>
	.figura {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0;
	}

	img {
		flex: none;
	}
</style>
