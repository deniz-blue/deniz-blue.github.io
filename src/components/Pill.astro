---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import { externalLinkAttributes } from "~/scripts/links";

interface Props extends HTMLAttributes<"a"> {
	href: string;
	icon?: ImageMetadata;
	name: string;
	glowGradient?: string;
	workInProgress?: boolean;
}

const { href, icon, name, glowGradient, workInProgress, ...attributes } = Astro.props;
---

<a
	{...attributes}
	class:list={["pill", { "work-in-progress": workInProgress }]}
	href={href}
	{...externalLinkAttributes(href)}
>
	{glowGradient && <span class="glow" style={{ background: glowGradient }} />}
	{
		icon && (
			<Image
				src={icon}
				alt=""
				aria-hidden
				loading="eager"
				width={16}
				height={16}
				densities={[1, 2]}
			/>
		)
	}
	<span class="name">{name}</span>
	{workInProgress && <span class="badge">WIP</span>}
</a>

<style>
	.pill {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 4px;
		padding: 0 var(--spacing-xs);
		overflow: hidden;
		border-radius: 999px;
		background: rgb(255 255 255 / 5%);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
		color: var(--color-text-strong);
		font-weight: 600;
		line-height: 1.6;
		text-decoration: none;
	}

	.work-in-progress {
		background: repeating-linear-gradient(-45deg, rgb(240 178 50 / 22%) 0 6px, rgb(255 255 255 / 4%) 6px 12px);
	}

	.badge {
		position: relative;
		align-self: center;
		padding: 0 0.25rem;
		border-radius: var(--radius-sm);
		background: #f0b232;
		color: #1a1a1a;
		font-size: var(--font-size-xs);
		font-weight: 700;
		line-height: 1rem;
	}

	.glow {
		position: absolute;
		top: 50%;
		left: 14px;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		opacity: 0.3;
		filter: blur(12px);
		transform: translate(-50%, -50%);
		transition: opacity 0.2s ease-in-out;
	}

	.pill:hover .glow {
		opacity: 0.5;
	}

	img,
	.name {
		position: relative;
	}

	img {
		align-self: center;
	}
</style>
